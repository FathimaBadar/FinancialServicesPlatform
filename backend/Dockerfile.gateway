# syntax=docker/dockerfile:1

# --- build stage ---
FROM eclipse-temurin:25-jdk-alpine AS build
WORKDIR /workspace

ENV GRADLE_VERSION=9.9.1
ENV GRADLE_HOME=/opt/gradle
RUN wget -q -O gradle.zip https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip \
    && unzip -q gradle.zip -d /opt \
    && mv /opt/gradle-${GRADLE_VERSION} ${GRADLE_HOME} \
    && rm gradle.zip
ENV PATH=${GRADLE_HOME}/bin:${PATH}

COPY gradle/wrapper/ gradle/wrapper/
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY shared/build.gradle.kts shared/src shared/src
COPY gateway/ gateway/

RUN gradle :gateway:bootJar --no-daemon -x test

# --- runtime stage ---
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

RUN addgroup -S fsp && adduser -S fsp -G fsp

COPY --from=build /workspace/gateway/build/libs/gateway*SNAPSHOT.jar app.jar

USER fsp

EXPOSE 8090
ENTRYPOINT ["java", "-jar", "app.jar"]
