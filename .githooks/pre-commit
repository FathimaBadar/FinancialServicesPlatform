#!/bin/sh
# FSP living-docs pre-commit: regenerate architecture artifacts, stage if changed.
# Installed by `make docs-hook` (git config core.hooksPath .githooks). CI re-checks with --check.
cd "$(git rev-parse --show-toplevel)" || exit 1
node docs/gen/refresh.cjs || { echo "docs/gen/refresh.cjs failed"; exit 1; }
if [ -n "$(git status --porcelain docs/generated)" ]; then
  git add docs/generated
  echo "docs/gen: refreshed and staged docs/generated/* in this commit"
fi
